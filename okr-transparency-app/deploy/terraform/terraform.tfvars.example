project_id = "knowledge-base-496322"
region     = "us-west1"

# image_tag is not set here. It lives in the tracked image_tag.auto.tfvars, which records what
# production is serving and takes precedence over this file. Setting it here would only shadow that
# record for whoever holds this machine's copy.

allowed_google_domains = "unitxlabs.com"
firestore_database_id  = "(default)"

# Start broad for the internal domain, or replace with:
#   group:eng@unitxlabs.com
#   user:your.name@unitxlabs.com
iap_enabled       = true
iap_principal     = "domain:unitxlabs.com"
invoker_principal = "domain:unitxlabs.com"

min_instances = 0
max_instances = 3

enable_admin_token_login = false
